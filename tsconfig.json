// Docusaurus does not use this file to build the website. It powers editor
// type checking and the explicit `npm run typecheck` CI command.
{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"],
      "@generated/*": ["./.docusaurus/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": [
      "node",
      "@docusaurus/module-type-aliases",
      "@docusaurus/theme-classic"
    ]
  },
  "include": [
    "docusaurus.config.ts",
    "sidebars.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [".docusaurus", "build", "node_modules"]
}
